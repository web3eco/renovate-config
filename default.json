{
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageTopic": "{{depName}}",
  "commitMessageAction": "update",
  "commitMessageExtra": "to {{newVersion}}{{#if isLockfileUpdate}} (lockfile){{/if}}",
  "extends": [
    ":enableVulnerabilityAlerts"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "dependencies"
    ],
    "assignees": [
      "@vladimirmyshkovski"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Dev dependencies — weekly, manual merge with approval",
      "matchDepTypes": [
        "dev",
        "devDependencies"
      ],
      "matchCategories": [
        "linting",
        "testing",
        "development"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "groupName": "dev dependencies (weekly)",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Production dependencies — monthly, require manual review",
      "matchDepTypes": [
        "dependencies",
        "production"
      ],
      "schedule": [
        "before 6am on the 1st day of the month"
      ],
      "groupName": "production dependencies (monthly)",
      "commitMessageTopic": "prod {{depName}}",
      "labels": [
        "dependencies",
        "prod"
      ],
      "reviewers": [
        "@vladimirmyshkovski"
      ]
    },
    {
      "description": "GitHub Actions — SHA-pinned, weekly digest bumps, manual merge",
      "matchManagers": [
        "github-actions"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "groupName": "github-actions",
      "commitMessageTopic": "github-actions digest",
      "pinDigests": true
    },
    {
      "description": "shared-actions — pin to approved tag, require review",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "web3eco/shared-actions"
      ],
      "schedule": [
        "before 6am on the 1st day of the month"
      ],
      "groupName": "web3eco shared-actions",
      "reviewers": [
        "@vladimirmyshkovski"
      ],
      "labels": [
        "dependencies",
        "shared-actions"
      ]
    },
    {
      "description": "TypeScript @types/* — grouped weekly, manual merge",
      "matchPackageNames": [
        "^@types/"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "groupName": "@types"
    },
    {
      "description": "ESLint ecosystem — grouped weekly, manual merge",
      "matchPackageNames": [
        "^eslint",
        "^@eslint/"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "groupName": "eslint"
    },
    {
      "description": "Major version bumps — always manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major"
      ],
      "reviewers": [
        "@vladimirmyshkovski"
      ]
    },
    {
      "description": "Lockfile refresh — weekly, no version bumps, manual merge",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "schedule": [
        "before 6am on sunday"
      ],
      "groupName": "lockfile maintenance",
      "commitMessageTopic": "refresh lockfiles"
    },
    {
      "description": "Repos on bun — only consider bun.lockb, ignore package-lock.json",
      "matchManagers": [
        "npm"
      ],
      "enabled": false,
      "matchFileNames": []
    },
    {
      "description": "@web3eco/* — resolve from GitHub Packages, not public npm",
      "matchPackageNames": [
        "@web3eco/*"
      ],
      "registryUrls": [
        "https://npm.pkg.github.com/"
      ]
    }
  ],
  "customDatasources": {},
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on sunday"
    ]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.aws-sam/**",
    "**/vendor/**",
    "**/archived/**"
  ],
  "branchPrefix": "renovate/",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 10,
  "ignoreTests": false,
  "hostRules": [
    {
      "matchHost": "npm.pkg.github.com",
      "token": "{{ secrets.GITHUB_PAT }}"
    }
  ]
}
